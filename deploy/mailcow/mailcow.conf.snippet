# Fragmentos para /opt/mailcow-dockerized/mailcow.conf
# Tras ./generate_config.sh — fusionar con tu archivo generado.

# Hostname obligatorio (coincide con registro A "mail")
MAILCOW_HOSTNAME=mail.conectatubarrio.cl

# Evitar choque con Coolify en 80/443 (UI Mailcow en 8080/8443)
# Tras cambiar: docker compose down && docker compose up -d
HTTP_PORT=8080
HTTPS_PORT=8443

# Zona horaria Chile
TZ=America/Santiago

# Si el VPS no tiene IPv6 público estable, en mailcow.conf oficial:
# SKIP_IPV6=y

# Tras tener certificado y DNS correctos, completar en panel:
# Configuration → Configuration & Details → DKIM → DNS
