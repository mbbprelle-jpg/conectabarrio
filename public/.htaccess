<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Detener la reescritura si es un archivo o directorio físico que ya existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir el resto al front controller
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
