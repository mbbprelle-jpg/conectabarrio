# Secretos locales (SMTP Brevo, etc.)
.env

# Dependencias PHP (generar con: composer install)
/vendor/
composer.phar

# Carpeta temporal y scripts de prueba
scratch/

# Archivos subidos por organizaciones (respaldar aparte de git)
storage/documentos/*
!storage/documentos/.gitkeep

# Configuración de editores de código
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Archivos del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Archivos de registro y logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
