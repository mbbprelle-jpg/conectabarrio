# Secretos locales (SMTP Brevo, etc.)
.env

# Dependencias PHP (generar con: composer install)
/vendor/
composer.phar

# Carpeta temporal y scripts de prueba
scratch/

# Archivos subidos por organizaciones (respaldar aparte de git)
storage/documentos/*
!storage/documentos/.gitkeep

# Videos muy pesados (superan 100 MB de GitHub). El tutorial usa tutorial-instalar-app.mpeg (~92 MB).
public/media/*.mp4

# Configuración de editores de código
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Archivos del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Archivos de registro y logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
